# ค่าสำหรับ Playwright E2E — คัดลอกเป็นไฟล์ .env.e2e แล้วกรอกค่าจริง (ไฟล์ .env.e2e ไม่ถูก commit)
# เว็บที่จะทดสอบ (ไม่ใส่ = เว็บจริงบน Vercel) เช่น http://localhost:3000 ถ้าทดสอบในเครื่อง
E2E_BASE_URL=https://vibe-code-messaging.vercel.app

# บัญชีทดสอบหลัก: สร้างโดยผู้ดูแลหลักที่ “บัญชีและผู้ใช้งาน” → แท็บ “ผู้ใช้งาน” (สิทธิ์ ผู้ใช้ทั่วไป + รหัสผ่าน)
# ห้ามใช้บัญชีผู้ดูแลหลัก (เทสต์จะไม่ยอมรัน)
E2E_OWNER_USERNAME=
E2E_OWNER_PASSWORD=

# บัญชีทดสอบที่สอง (ใช้ทดสอบสมาชิก B5–B9) สร้างแบบเดียวกัน
E2E_MEMBER_USERNAME=
E2E_MEMBER_PASSWORD=
