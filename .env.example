# ═══════════════════════════════════════════════════════════════
#  LINE OA Auto Reply Manager — Environment Variables
#  คัดลอกไฟล์นี้เป็น .env แล้วกำหนดค่าจริง (ห้าม commit ไฟล์ .env)
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://lineoa:CHANGE_ME@localhost:5432/lineoa?schema=public"

# ── Security ────────────────────────────────────────────────────
# คีย์เข้ารหัส LINE Credentials / Reply Token (AES-256-GCM) — ต้องเป็น 32 bytes
# สร้างด้วยคำสั่ง: openssl rand -base64 32
# ⚠️ ห้ามเปลี่ยนหลังใช้งานจริง มิฉะนั้นจะถอดรหัส Credentials เดิมไม่ได้ (ต้องบันทึก Credentials ใหม่)
ENCRYPTION_KEY=""

# URL สาธารณะของระบบ (ต้องเป็น HTTPS ใน Production) ใช้สร้าง Webhook URL และ URL รูปภาพ
APP_URL="https://bot.example.com"

# อายุ Session ของผู้ดูแล (ชั่วโมง) — ค่าเริ่มต้น 168 (7 วัน)
SESSION_TTL_HOURS=168

# Cookie Secure: auto = ใช้ secure เมื่อ APP_URL เป็น https | true | false
COOKIE_SECURE="auto"

# เชื่อถือ X-Forwarded-For / X-Forwarded-Host จาก Reverse Proxy (Nginx/Caddy)
TRUST_PROXY="true"

# ── LINE Messaging API (ไม่บังคับ) ──────────────────────────────
# สามารถตั้งค่าผ่านหน้า "LINE OA Settings" ได้ (จะเข้ารหัสเก็บในฐานข้อมูล)
# ถ้ากำหนดที่นี่ ค่าจาก Environment จะมีลำดับความสำคัญสูงกว่า
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ── Background Worker (Queue) ───────────────────────────────────
# ประมวลผล Webhook Event ในพื้นหลัง (FOR UPDATE SKIP LOCKED — รันหลาย instance ได้)
QUEUE_WORKER_ENABLED="true"
QUEUE_POLL_INTERVAL_MS=3000

# ระดับ Log เริ่มต้นก่อนอ่านค่าจากหน้าตั้งค่า: debug | info | warn | error
LOG_LEVEL="info"

# ── Seed (ใช้ตอนติดตั้งครั้งแรก) ─────────────────────────────────
# ผู้ดูแลระบบคนแรก (OWNER) — รหัสผ่านอย่างน้อย 10 ตัวอักษร มีตัวอักษรและตัวเลข
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="ผู้ดูแลระบบ"
# true = สร้างลูกค้า/ข้อความตัวอย่างสำหรับทดสอบ (ไม่ควรใช้ใน Production)
SEED_DEMO_DATA="false"

# ── docker-compose เท่านั้น ─────────────────────────────────────
POSTGRES_USER="lineoa"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="lineoa"
# โดเมนสำหรับ Caddy (HTTPS อัตโนมัติ) เมื่อใช้ profile "https"
DOMAIN="bot.example.com"
